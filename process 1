#creation of process
#include <stdio.h>
#include <unistd.h>
#include <sys/types.h>

int main()
{
    pid_t pid = fork();

    if(pid < 0)
    {
        printf("Fork failed\n");
        return 1;
    }
    else if(pid == 0)
    {
        printf("Hello from the child process\n");
    }
    else
    {
        printf("Hello from the parent process\n");
    }

    return 0;
}
