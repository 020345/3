1. Solve the producer consumer problem for a single piece of data using binary
semaphore.
#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

int buffer;

sem_t empty;
sem_t full;

void *producer(void *arg)
{
    int item;

    for(item = 1; item <= 5; item++)
    {
        sem_wait(&empty);

        buffer = item;
        printf("Producer produced: %d\n", item);

        sem_post(&full);
    }

    return NULL;
}

void *consumer(void *arg)
{
    int item;

    for(int i = 1; i <= 5; i++)
    {
        sem_wait(&full);

        item = buffer;
        printf("Consumer consumed: %d\n", item);

        sem_post(&empty);
    }

    return NULL;
}

int main()
{
    pthread_t producerThread, consumerThread;

    sem_init(&empty, 0, 1);
    sem_init(&full, 0, 0);

    pthread_create(&producerThread, NULL, producer, NULL);
    pthread_create(&consumerThread, NULL, consumer, NULL);

    pthread_join(producerThread, NULL);
    pthread_join(consumerThread, NULL);

    sem_destroy(&empty);
    sem_destroy(&full);

    return 0;
}







2. Solve the above problem for two consumer processes.
#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

int buffer;

sem_t empty;
sem_t full;

void *producer(void *arg)
{
    int item;

    for(item = 1; item <= 4; item++)
    {
        sem_wait(&empty);

        buffer = item;
        printf("Producer produced: %d\n", item);

        sem_post(&full);
    }

    return NULL;
}

void *consumer(void *arg)
{
    int consumer_id = *(int *)arg;
    int item;

    for(int i = 1; i <= 2; i++)
    {
        sem_wait(&full);

        item = buffer;
        printf("Consumer %d consumed: %d\n", consumer_id, item);

        sem_post(&empty);
    }

    return NULL;
}

int main()
{
    pthread_t producerThread, consumerThread1, consumerThread2;

    int id1 = 1, id2 = 2;

    sem_init(&empty, 0, 1);
    sem_init(&full, 0, 0);

    pthread_create(&producerThread, NULL, producer, NULL);
    pthread_create(&consumerThread1, NULL, consumer, &id1);
    pthread_create(&consumerThread2, NULL, consumer, &id2);

    pthread_join(producerThread, NULL);
    pthread_join(consumerThread1, NULL);
    pthread_join(consumerThread2, NULL);

    sem_destroy(&empty);
    sem_destroy(&full);

    return 0;
}







3. Solve the producer problem by a bounded length array.
#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

#define SIZE 5

int buffer[SIZE];
int in = 0;
int out = 0;

sem_t empty;
sem_t full;
sem_t mutex;

void *producer(void *arg)
{
    int item;

    for(item = 1; item <= 5; item++)
    {
        sem_wait(&empty);
        sem_wait(&mutex);

        buffer[in] = item;
        printf("Producer produced: %d\n", item);

        in = (in + 1) % SIZE;

        sem_post(&mutex);
        sem_post(&full);
    }

    return NULL;
}

void *consumer(void *arg)
{
    int item;

    for(int i = 1; i <= 5; i++)
    {
        sem_wait(&full);
        sem_wait(&mutex);

        item = buffer[out];
        printf("Consumer consumed: %d\n", item);

        out = (out + 1) % SIZE;

        sem_post(&mutex);
        sem_post(&empty);
    }

    return NULL;
}

int main()
{
    pthread_t producerThread, consumerThread;

    sem_init(&empty, 0, SIZE);
    sem_init(&full, 0, 0);
    sem_init(&mutex, 0, 1);

    pthread_create(&producerThread, NULL, producer, NULL);
    pthread_create(&consumerThread, NULL, consumer, NULL);

    pthread_join(producerThread, NULL);
    pthread_join(consumerThread, NULL);

    sem_destroy(&empty);
    sem_destroy(&full);
    sem_destroy(&mutex);

    return 0;
}







4. Write a program that uses several Pthread condition variable routines. The
main routine creates three threads. Two of the threads perform work and
update a "count" variable. The third thread waits until the count variable
reaches a specified value (say 500).

#include <stdio.h>
#include <pthread.h>
#include <unistd.h>

#define TCOUNT 200
#define FINAL_COUNT 400

int count = 0;

pthread_mutex_t count_mutex;
pthread_cond_t count_threshold_cv;

void *inc_count(void *arg)
{
    long my_id = (long)arg;

    for (int i = 0; i < FINAL_COUNT; i++)
    {
        pthread_mutex_lock(&count_mutex);

        count++;

        if (count == TCOUNT)
        {
            printf("inc_count(): Thread %ld reached threshold %d. Signalling watcher...\n",
                   my_id, TCOUNT);

            pthread_cond_signal(&count_threshold_cv);
        }

        pthread_mutex_unlock(&count_mutex);

        usleep(1000);
    }

    return NULL;
}

void *watch_count(void *arg)
{
    long my_id = (long)arg;

    pthread_mutex_lock(&count_mutex);

    while (count < TCOUNT)
    {
        printf("watch_count(): Thread %ld waiting on condition variable...\n", my_id);

        pthread_cond_wait(&count_threshold_cv, &count_mutex);

        printf("watch_count(): Thread %ld received signal.\n", my_id);
    }

    printf("watch_count(): Thread %ld final threshold verified. Current count = %d\n",
           my_id, count);

    pthread_mutex_unlock(&count_mutex);

    return NULL;
}

int main()
{
    pthread_t thread1, thread2, thread3;

    long id1 = 1, id2 = 2, id3 = 3;

    pthread_mutex_init(&count_mutex, NULL);
    pthread_cond_init(&count_threshold_cv, NULL);

    pthread_create(&thread3, NULL, watch_count, (void *)id3);
    pthread_create(&thread1, NULL, inc_count, (void *)id1);
    pthread_create(&thread2, NULL, inc_count, (void *)id2);

    pthread_join(thread1, NULL);
    pthread_join(thread2, NULL);
    pthread_join(thread3, NULL);

    printf("Main(): All threads completed. Final count = %d\n", count);

    pthread_mutex_destroy(&count_mutex);
    pthread_cond_destroy(&count_threshold_cv);

    return 0;
}
