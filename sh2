15.Write a shell script that shows the names of all the non-directory files in
the current directory and calculates the sum of the size of them.
#!/bin/bash

sum=0

echo "Non-directory files are:"

for file in *
do
    if [ -f "$file" ]
    then
        echo "$file"
        size=$(wc -c < "$file")
        sum=$((sum + size))
    fi
done

echo "Total size of all files = $sum bytes"






