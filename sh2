12.Write a shell script that accepts two directories namely OS1 and OS2 as
arguments and deletes those files in OS2 which are identical to their
names in OS1.
#!/bin/bash

for file in "$1"/*
do
    name=$(basename "$file")

    if [ -f "$2/$name" ]
    then
        rm "$2/$name"
        echo "$name deleted from $2"
    fi
done







