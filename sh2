8. Write a shell script to check whether a given number is prime or not.
#!/bin/bash

echo "Enter a number:"
read num

flag=0

for ((i=2; i<num; i++))
do
    if [ $((num % i)) -eq 0 ]
    then
        flag=1
        break
    fi
done

if [ $num -le 1 ]
then
    echo "$num is not a prime number"
elif [ $flag -eq 0 ]
then
    echo "$num is a prime number"
else
    echo "$num is not a prime number"
fi






