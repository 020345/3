1. Write a multi-threaded program where the main thread gets an integer
number range from the user and then creates two child threads; one
thread finds odd numbers in the range and print them, and the second
thread finds even numbers in the range and prints them. The child thread
must terminate by returning a value. The parent thread must wait for the
child threads to finish and it must also print the return values of the child
threads.

#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>

struct Range
{
    int start;
    int end;
};

// Thread function to print odd numbers
void *printOdd(void *arg)
{
    struct Range *r = (struct Range *)arg;

    int *count = (int *)malloc(sizeof(int));
    *count = 0;

    printf("Odd Numbers: ");

    for (int i = r->start; i <= r->end; i++)
    {
        if (i % 2 != 0)
        {
            printf("%d ", i);
            (*count)++;
        }
    }

    printf("\n");

    pthread_exit((void *)count);
}

// Thread function to print even numbers
void *printEven(void *arg)
{
    struct Range *r = (struct Range *)arg;

    int *count = (int *)malloc(sizeof(int));
    *count = 0;

    printf("Even Numbers: ");

    for (int i = r->start; i <= r->end; i++)
    {
        if (i % 2 == 0)
        {
            printf("%d ", i);
            (*count)++;
        }
    }

    printf("\n");

    pthread_exit((void *)count);
}

int main()
{
    pthread_t oddThread, evenThread;
    struct Range range;

    int *oddCount;
    int *evenCount;

    printf("Enter starting number: ");
    scanf("%d", &range.start);

    printf("Enter ending number: ");
    scanf("%d", &range.end);

    // Create odd thread
    pthread_create(&oddThread, NULL, printOdd, &range);

    // Create even thread
    pthread_create(&evenThread, NULL, printEven, &range);

    // Wait for odd thread to finish
    pthread_join(oddThread, (void **)&oddCount);

    // Wait for even thread to finish
    pthread_join(evenThread, (void **)&evenCount);

    printf("Returned value from Odd Thread = %d\n", *oddCount);
    printf("Returned value from Even Thread = %d\n", *evenCount);

    free(oddCount);
    free(evenCount);

    pthread_exit(NULL);
}








2. Write a multi-threaded program where the main thread gets an integer
number range from the user and then creates two child threads; one
thread calculates the sum of all numbers in the range and prints it, and
the second thread finds prime numbers in the range and prints them.
The child thread must terminate by returning a value. The parent thread
must wait for the child threads to finish, and it must also print the return
values of the child threads.

#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>

struct Range
{
    int start;
    int end;
};

// Thread function to calculate sum
void *findsum(void *arg)
{
    struct Range *r = (struct Range *)arg;

    int *sum = (int *)malloc(sizeof(int));
    *sum = 0;

    for (int i = r->start; i <= r->end; i++)
    {
        *sum += i;
    }

    printf("Sum of numbers = %d\n", *sum);

    pthread_exit((void *)sum);
}

// Thread function to find prime numbers
void *findprime(void *arg)
{
    struct Range *r = (struct Range *)arg;

    int *count = (int *)malloc(sizeof(int));
    *count = 0;

    printf("Prime Numbers: ");

    for (int i = r->start; i <= r->end; i++)
    {
        if (i < 2)
            continue;

        int prime = 1;

        for (int j = 2; j <= i / 2; j++)
        {
            if (i % j == 0)
            {
                prime = 0;
                break;
            }
        }

        if (prime)
        {
            printf("%d ", i);
            (*count)++;
        }
    }

    printf("\n");

    pthread_exit((void *)count);
}

int main()
{
    pthread_t sumThread, primeThread;
    struct Range range;

    int *sumResult;
    int *primeCount;

    printf("Enter starting number: ");
    scanf("%d", &range.start);

    printf("Enter ending number: ");
    scanf("%d", &range.end);

    // Create Sum Thread
    pthread_create(&sumThread, NULL, findsum, &range);

    // Create Prime Thread
    pthread_create(&primeThread, NULL, findprime, &range);

    // Wait for Sum Thread
    pthread_join(sumThread, (void **)&sumResult);

    // Wait for Prime Thread
    pthread_join(primeThread, (void **)&primeCount);

    printf("Returned value from Sum Thread = %d\n", *sumResult);
    printf("Returned value from Prime Thread = %d\n", *primeCount);

    free(sumResult);
    free(primeCount);

    pthread_exit(NULL);
}
